# Required. Get a key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Gemma 4 model on the Gemini API.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional. Gemma 4 thinking: high | minimal
GEMMA_THINKING_LEVEL=high

# Optional. CORS origin for a separate frontend. Use * for local testing.
CORS_ORIGIN=*
